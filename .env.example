# Copy to ignored .env.local. Never commit real tokens.
# The Zetaris adapter also accepts ZETARIS_REST_URL as an alias.
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Verified public synthetic feeds; replace for your own deployed origin.
TRACEHARBOR_PUBLIC_ORIGIN=https://traceharbor.web.app

# Nightshift Runtime settings. This build uses a local model, not a cloud key.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=meterless/auto
# Replace the generic routing alias with the discovered local model ID after
# starting the model. The alias alone is not proof of any model or vendor.

# Select the runner mode explicitly: --mode sample or --mode live.
# Sample mode needs no credentials and must not claim live sponsor calls.
